# Copia como .env en la raiz. Completa la key solo en tu equipo.
# No usar prefijo VITE_ para secretos ni subir archivos .env al repositorio.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
PORT=3001
# Opcional, solo cuando exista un dominio publico real. No es un secreto.
# Origen HTTPS sin ruta; se usa al compilar para canonical y enlaces sociales.
SITE_URL=
